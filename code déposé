    if(resnap){ resnap=0; tref=t; for(long q=0;q<nt;q++){ long k=touched[q]; G[k]=(G[k]&~2)|((G[k]&1)<<1); } ndiff=0;
      for(int i=0;i<n;i++){RX[i]=A[i].x;RY[i]=A[i].y;RD[i]=A[i].d;} }
