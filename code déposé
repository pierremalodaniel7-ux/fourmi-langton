  uint8_t*h[16]; for(int i=0;i<n;i++) h[i]=malloc(T+1);
  for(long t=1;t<=T;t++) for(int i=0;i<n;i++){ uint8_t*sl=g_slot(&g,KEY(X[i],Y[i])); int col=*sl; D[i]=(D[i]+turn[col])%M; *sl=(col+1)%q; X[i]+=DX[D[i]]; Y[i]+=DY[D[i]]; h[i][t]=D[i]; }
